{
  "name": "hono-api",
  "version": "1.0.0",
  "private": true,
  "description": "Reference Hono API demonstrating all @batkit packages",
  "type": "module",
  "scripts": {
    "dev": "esno --env-file=.env.dev --watch src/index.ts",
    "build": "tsc --build",
    "build:clean": "tsc --build --clean",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "vp check .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@batkit/errors": "workspace:*",
    "@batkit/logger": "workspace:*",
    "@batkit/logger-pino": "workspace:*",
    "@batkit/rfc9457": "workspace:*",
    "@hono/node-server": "^2.1.0",
    "@hono/zod-openapi": "^0.19.10",
    "@scalar/hono-api-reference": "^0.11.13",
    "hono": "^4.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esno": "^4.8.0",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.2",
    "vite-plus": "^0.1.14"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
