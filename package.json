{
  "name": "@batkit/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Better Application Toolkit - Observability and reliability toolkit for Node.js applications",
  "keywords": [
    "error-handling",
    "express",
    "logging",
    "middleware",
    "observability",
    "rfc9457",
    "toolkit"
  ],
  "license": "MIT",
  "author": "Ken Courville",
  "repository": {
    "type": "git",
    "url": "https://github.com/krcourville/better-application-toolkit.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "vp run -r --cache build",
    "build:clean": "vp run -r clean && tsc --build --clean",
    "test": "vp run -r --cache test",
    "test:watch": "vp test -w",
    "check": "vp check",
    "lint": "vp check",
    "lint:fix": "vp check --fix",
    "typecheck": "vp run -r --cache typecheck",
    "knip": "knip",
    "publint": "vp run -r --cache publint",
    "attw": "vp run -r --cache attw",
    "dev:express-api": "LOCAL_DEV=true vp run --filter express-api... dev",
    "dev:hono-api": "LOCAL_DEV=true vp run --filter hono-api... dev",
    "start:express-api": "vp run --no-cache --filter express-api... build && LOCAL_DEV=true node apps/express-api/dist/index.js",
    "start:hono-api": "vp run --no-cache --filter hono-api... build && LOCAL_DEV=true node apps/hono-api/dist/index.js",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "vp run -r --cache build && changeset publish",
    "stop-server:express-api": "lsof -ti :3785 | xargs kill -9",
    "stop-server:hono-api": "lsof -ti :3786 | xargs kill -9",
    "cli": "vp run -t cli-app#build && vp run --filter cli-app dev"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.27.10",
    "knip": "^6.27.0",
    "pino-pretty": "^13.0.0",
    "publint": "^0.3.21",
    "typescript": "^5.7.2",
    "vite": "^8.0.3",
    "vite-plus": "^0.1.14",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1"
    }
  }
}
